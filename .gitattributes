* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Keep Unity YAML and source files consistent across Windows and macOS.
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.ps1 text eol=crlf
*.meta text eol=lf
*.unity text eol=lf
*.scenetemplate text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Source art and other large binary assets.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
